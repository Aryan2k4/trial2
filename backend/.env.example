# Copy to backend/.env for local development. Do not commit the real .env.
DATABASE_URL=sqlite:///./data/facilityops.db
AI_PROVIDER=mock
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-sharing
ENABLE_TENSORFLOW=false
# Install requirements-deep-learning.txt and set true for full local inference.
# On free hosting, use a persistent external PostgreSQL DATABASE_URL.
# Set one only when using a real AI provider.
# GROQ_API_KEY=
# GEMINI_API_KEY=
